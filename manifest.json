{
  "manifest_version": 3,
  "name": "Go to URL: Fullscreen Address Bar & Tab Switcher",
  "short_name": "Go to URL",
  "version": "1.0.0",
  "description": "Chrome in fullscreen (F11) hides the address bar. Press Alt+G: type an address or search, switch tabs. You never leave fullscreen.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "search",
    "tabs",
    "sessions",
    "favicon"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "_favicon/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "open-prompt": {
      "suggested_key": {
        "default": "Alt+G"
      },
      "description": "Open the go-to-URL prompt"
    }
  }
}
